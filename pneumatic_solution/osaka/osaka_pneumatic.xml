<mujoco model="Test_osaka_pneumatic_horizontal">

  <option timestep="0.002" gravity="0 0 -9.81" />
  <compiler angle="radian"/>

  <asset>
    <mesh name="frigo_mesh" file="osaka_corpo.obj"/>
    <mesh name="porta_sx_mesh" file="osaka_portasx.obj"/>
    <mesh name="porta_dx_mesh" file="osaka_portadx.obj"/>
  </asset>

  <worldbody>
    <geom name="pavimento" type="plane" size="5 5 0.1" rgba="0.8 0.9 0.8 1"/>
    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" pos="0 0 5" dir="0 0 -1" castshadow="false"/>

    <!-- Pneumatico orizzontale porta sinistra -->
    <body name="supporto_pneumatico_sx" pos="-1.70 0.55 0.50">
        <geom name="supporto_base_sx" type="sphere" pos="-0.10 0 0" size="0.045" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
        <site name="base_cilindro_sx" pos="-0.1 0 0" size="0.035" rgba="1 0 0 1"/>

        <body name="canna_cilindro_sx" pos="0 0 0" zaxis="1 0 0">
            <inertial pos="0 0 0.30" mass="1.5" diaginertia="0.060 0.060 0.010"/>
            <geom name="canna_visual_sx" type="cylinder" pos="0 0 0.30" size="0.035 0.40" rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0"/>

            <body name="stelo_cilindro_sx" pos="0 0 0">
            <joint name="corsa_cilindro_sx" type="slide" axis="0 0 1" range="0 0.70" limited="true" damping="20" frictionloss="5"/>
            <inertial pos="0 0 0.35" mass="0.8" diaginertia="0.018 0.018 0.003"/>
            <geom name="stelo_visual_sx" type="cylinder" pos="0 0 0.35" size="0.018 0.45" rgba="0.85 0.85 0.85 1" contype="0" conaffinity="0"/>

            <body name="staffa_stelo_sx" pos="0 0 0.80">
            <joint name="snodo_stelo_staffa_sx" type="ball" damping="0.05"/>
            <inertial pos="0 0.14 0" mass="0.25" diaginertia="0.002 0.002 0.002"/>

            <!-- Snodo rosso tra stelo e staffa -->
            <geom name="snodo_stelo_staffa_visual_sx" type="sphere" pos="0 0 0" size="0.03" rgba="1 0 0 1" contype="0" conaffinity="0"/>

            <!-- Staffa in direzione +y verso la maniglia -->
            <geom name="staffa_cilindro_sx" type="capsule" fromto="0 0 0 0 0.28 0" size="0.012" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>

            <!-- Punto verde di aggancio staffa-maniglia -->
            <geom name="aggrappo_staffa_maniglia_sx_visual" type="sphere" pos="0 0.28 0" size="0.03" rgba="0 1 0 1" contype="0" conaffinity="0"/>
            <site name="aggrappo_staffa_maniglia_sx" pos="0 0.28 0" size="0.025" rgba="0 1 0 0.5"/>
            </body>
            </body>
        </body>
    </body>

    <!-- Pneumatico orizzontale porta destra -->
    <body name="supporto_pneumatico_dx" pos="1.67 0.55 0.50">
        <geom name="supporto_base_dx" type="sphere" pos="0.1 0 0" size="0.045" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
        <site name="base_cilindro_dx" pos="0.1 0 0" size="0.035" rgba="1 0 0 1"/>

        <body name="canna_cilindro_dx" pos="0 0 0" zaxis="-1 0 0">
            <inertial pos="0 0 0.30" mass="1.5" diaginertia="0.060 0.060 0.010"/>
            <geom name="canna_visual_dx" type="cylinder" pos="0 0 0.30" size="0.035 0.40" rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0"/>

            <body name="stelo_cilindro_dx" pos="0 0 0">
            <joint name="corsa_cilindro_dx" type="slide" axis="0 0 1" range="0 0.70" limited="true" damping="20" frictionloss="5"/>
            <inertial pos="0 0 0.35" mass="0.8" diaginertia="0.018 0.018 0.003"/>
            <geom name="stelo_visual_dx" type="cylinder" pos="0 0 0.35" size="0.018 0.45" rgba="0.85 0.85 0.85 1" contype="0" conaffinity="0"/>

            <body name="staffa_stelo_dx" pos="0 0 0.80">
            <joint name="snodo_stelo_staffa_dx" type="ball" damping="0.05"/>
            <inertial pos="0 0.125 0" mass="0.25" diaginertia="0.002 0.002 0.002"/>

            <!-- Snodo rosso tra stelo e staffa -->
            <geom name="snodo_stelo_staffa_visual_dx" type="sphere" pos="0 0 0" size="0.03" rgba="1 0 0 1" contype="0" conaffinity="0"/>

            <!-- Staffa in direzione +y verso la maniglia -->
            <geom name="staffa_cilindro_dx" type="capsule" fromto="0 0 0 0 0.25 0" size="0.012" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>

            <!-- Punto verde di aggancio staffa-maniglia -->
            <geom name="aggrappo_staffa_maniglia_dx_visual" type="sphere" pos="0 0.25 0" size="0.03" rgba="0 1 0 1" contype="0" conaffinity="0"/>
            <site name="aggrappo_staffa_maniglia_dx" pos="0 0.25 0" size="0.025" rgba="0 1 0 0.5"/>
            </body>
            </body>
        </body>
    </body>

    <!-- Banco frigo Osaka -->
    <body name="banco_frigo" pos="-1 0.7 0">
      <geom type="mesh" mesh="frigo_mesh" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>

      <body name="porta_sx" pos="0 0 0">
        <joint name="slide_sx" type="slide" axis="1 0 0" range="0 0.8" limited="true" damping="3" frictionloss="33"/>
        <inertial pos="0.48 0.3 0.7" mass="20" diaginertia="1.38033 2.88433 1.50433"/>
        <geom type="mesh" mesh="porta_sx_mesh" rgba="0.3 0.8 0.9 0.4" contype="0" conaffinity="0"/>

        <body name="maniglia_sx" pos="0.1 0.13 0.5" euler="2.8 0 0">
          <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
          <geom name="manigliasx" type="cylinder" size="0.015 0.15" rgba="0.8 0.2 0.2 1" contype="0" conaffinity="0"/>
          <site name="target_manigliasx" pos="0 0 0" size="0.02" rgba="1 0 0 0.5"/>
        </body>
      </body>

      <body name="porta_dx" pos="0 0 0">
        <joint name="slide_dx" type="slide" axis="-1 0 0" range="0 0.8" limited="true" damping="3" frictionloss="33"/>
        <inertial pos="1.48 0.3 0.7" mass="20" diaginertia="1.38033 2.88433 1.50433"/>
        <geom type="mesh" mesh="porta_dx_mesh" rgba="0.3 0.8 0.9 0.4" contype="0" conaffinity="0"/>

        <body name="maniglia_dx" pos="1.87 0.1 0.5" euler="2.8 0 0">
          <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
          <geom name="manigliadx" type="cylinder" size="0.015 0.15" rgba="0.8 0.2 0.2 1" contype="0" conaffinity="0"/>
          <site name="target_manigliadx" pos="0 0 0" size="0.02" rgba="1 0 0 0.5"/>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <connect name="connessione_staffa_maniglia_sx" site1="aggrappo_staffa_maniglia_sx" site2="target_manigliasx" solimp="0.9 0.95 0.001" solref="0.02 1"/>
    <connect name="connessione_staffa_maniglia_dx" site1="aggrappo_staffa_maniglia_dx" site2="target_manigliadx" solimp="0.9 0.95 0.001" solref="0.02 1"/>
  </equality>

  <actuator>
    <motor name="forza_pneumatica_sx" joint="corsa_cilindro_sx" gear="1" ctrllimited="true" ctrlrange="-1000 1000"/>
    <motor name="forza_pneumatica_dx" joint="corsa_cilindro_dx" gear="1" ctrllimited="true" ctrlrange="-1000 1000"/>
  </actuator>

</mujoco>