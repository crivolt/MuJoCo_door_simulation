<mujoco model="Test_athen_xl_pneumatic_horizontal">

  <option timestep="0.002" gravity="0 0 -9.81"/>
  <compiler angle="radian"/>

  <asset>
    <mesh name="frigo_mesh" file="athen_xl_corpo.obj"/>
    <mesh name="porta_sx_mesh" file="athen_xl_portasx.obj"/>
    <mesh name="porta_dx_mesh" file="athen_xl_portadx.obj"/>
  </asset>

  <worldbody>
    <geom name="pavimento" type="plane" size="5 5 0.1" rgba="0.8 0.9 0.8 1"/>
    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" pos="0 0 5" dir="0 0 -1" castshadow="false"/>

    <!-- Pneumatico orizzontale porta sinistra -->
    <body name="supporto_pneumatico_sx" pos="-2.30 0.75 1.12">
        <geom name="supporto_base_sx" type="sphere" size="0.045" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
        <site name="base_cilindro_sx" pos="0 0 0" size="0.035" rgba="1 0 0 1"/>

        <body name="canna_cilindro_sx" pos="0 0 0" zaxis="1 0 0">
            <inertial pos="0 0 0.525" mass="1.5" diaginertia="0.060 0.060 0.010"/>
            <geom name="canna_visual_sx" type="cylinder" pos="0 0 0.525" size="0.035 0.525" rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0"/>

            <body name="stelo_cilindro_sx" pos="0 0 0">
            <joint name="corsa_cilindro_sx" type="slide" axis="0 0 1" range="0 0.90" limited="true" damping="20" frictionloss="5"/>
            <inertial pos="0 0 0.60" mass="0.8" diaginertia="0.020 0.020 0.003"/>
            <geom name="stelo_visual_sx" type="cylinder" pos="0 0 0.60" size="0.018 0.60" rgba="0.85 0.85 0.85 1" contype="0" conaffinity="0"/>

            <body name="staffa_stelo_sx" pos="0 0 1.20">
              <joint name="snodo_stelo_staffa_sx" type="ball" damping="2.0" limited="true" range="0 0.0174533" solreflimit="0.004 1" solimplimit="0.95 0.99 0.001"/>
              <inertial pos="0.12 0 0" mass="0.3" diaginertia="0.002 0.002 0.002"/>

              <!-- Snodo rosso tra stelo e staffa -->
              <geom name="snodo_stelo_staffa_visual_sx" type="sphere" pos="0 0 0" size="0.035" rgba="1 0 0 1" contype="0" conaffinity="0"/>

              <!-- Staffa verticale, parte dello stelo -->
              <geom name="staffa_cilindro_sx" type="capsule" fromto="0 0 0 0.24 0 0" size="0.012" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>

              <!-- Punto verde di aggrappo staffa-maniglia -->
              <geom name="aggrappo_staffa_maniglia_sx_visual" type="sphere" pos="0.24 0 0" size="0.03" rgba="0 1 0 1" contype="0" conaffinity="0"/>
              <site name="aggrappo_staffa_maniglia_sx" pos="0.24 0 0" size="0.025" rgba="0 1 0 0.5"/>
            </body>
            </body>
        </body>
    </body>

    <!-- Pneumatico orizzontale porta destra -->
    <body name="supporto_pneumatico_dx" pos="2.42 0.75 1.12">
        <geom name="supporto_base_dx" type="sphere" size="0.045" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
        <site name="base_cilindro_dx" pos="0 0 0" size="0.035" rgba="1 0 0 1"/>

        <body name="canna_cilindro_dx" pos="0 0 0" zaxis="-1 0 0">
            <inertial pos="0 0 0.525" mass="1.5" diaginertia="0.060 0.060 0.010"/>
            <geom name="canna_visual_dx" type="cylinder" pos="0 0 0.525" size="0.035 0.525" rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0"/>

            <body name="stelo_cilindro_dx" pos="0 0 0">
            <joint name="corsa_cilindro_dx" type="slide" axis="0 0 1" range="0 0.90" limited="true" damping="20" frictionloss="5"/>
            <inertial pos="0 0 0.60" mass="0.8" diaginertia="0.020 0.020 0.003"/>
            <geom name="stelo_visual_dx" type="cylinder" pos="0 0 0.60" size="0.018 0.60" rgba="0.85 0.85 0.85 1" contype="0" conaffinity="0"/>

            <body name="staffa_stelo_dx" pos="0 0 1.20">
              <joint name="snodo_stelo_staffa_dx" type="ball" damping="2.0" limited="true" range="0 0.0174533" solreflimit="0.004 1" solimplimit="0.95 0.99 0.001"/>
              <inertial pos="-0.115 0 0" mass="0.3" diaginertia="0.002 0.002 0.002"/>

              <!-- Snodo rosso tra stelo e staffa -->
              <geom name="snodo_stelo_staffa_visual_dx" type="sphere" pos="0 0 0" size="0.035" rgba="1 0 0 1" contype="0" conaffinity="0"/>

              <!-- Staffa verticale, parte dello stelo -->
              <geom name="staffa_cilindro_dx" type="capsule" fromto="0 0 0 -0.23 0 0" size="0.012" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>

              <!-- Punto verde di aggrappo staffa-maniglia -->
              <geom name="aggrappo_staffa_maniglia_dx_visual" type="sphere" pos="-0.23 0 0" size="0.03" rgba="0 1 0 1" contype="0" conaffinity="0"/>
              <site name="aggrappo_staffa_maniglia_dx" pos="-0.23 0 0" size="0.025" rgba="0 1 0 0.5"/>
            </body>
            </body>
        </body>
    </body>

    <!-- Banco frigo Athen XL -->
    <body name="banco_frigo" pos="-1.2 0.45 0">
      <geom type="mesh" mesh="frigo_mesh" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>

      <body name="porta_sx" pos="0 0 0">
        <joint name="slide_sx" type="slide" axis="1 0 0" range="0 1.06" limited="true" damping="30" frictionloss="41.9"/>
        <inertial pos="0.65 0.7 0.9" mass="12" diaginertia="0.9801 1.5376 2.5177"/>
        <geom type="mesh" mesh="porta_sx_mesh" rgba="0.3 0.8 0.9 0.4" contype="0" conaffinity="0"/>

        <body name="maniglia_sx" pos="0.1 0.3 0.88" euler="1.75 0 0">
          <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
          <geom name="manigliasx" type="cylinder" size="0.015 0.1" rgba="0.8 0.2 0.2 1" contype="0" conaffinity="0"/>
          <site name="target_manigliasx" pos="0 0 0" size="0.02" rgba="1 0 0 0.5"/>
        </body>
      </body>

      <body name="porta_dx" pos="0 0 0">
        <joint name="slide_dx" type="slide" axis="-1 0 0" range="0 1.06" limited="true" damping="30" frictionloss="41.9"/>
        <inertial pos="1.85 0.7 0.9" mass="12" diaginertia="0.9801 1.5376 2.5177"/>
        <geom type="mesh" mesh="porta_dx_mesh" rgba="0.3 0.8 0.9 0.4" contype="0" conaffinity="0"/>

        <body name="maniglia_dx" pos="2.42 0.3 0.89" euler="1.75 0 0">
          <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
          <geom name="manigliadx" type="cylinder" size="0.015 0.1" rgba="0.8 0.2 0.2 1" contype="0" conaffinity="0"/>
          <site name="target_manigliadx" pos="0 0 0" size="0.02" rgba="1 0 0 0.5"/>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <connect name="connessione_staffa_maniglia_sx" site1="aggrappo_staffa_maniglia_sx" site2="target_manigliasx" solimp="0.9 0.95 0.001" solref="0.02 1"/>
    <connect name="connessione_staffa_maniglia_dx" site1="aggrappo_staffa_maniglia_dx" site2="target_manigliadx" solimp="0.9 0.95 0.001" solref="0.02 1"/>
  </equality>

  <actuator>
    <motor name="forza_pneumatica_sx" joint="corsa_cilindro_sx" gear="1" ctrllimited="true" ctrlrange="-200 200"/>
    <motor name="forza_pneumatica_dx" joint="corsa_cilindro_dx" gear="1" ctrllimited="true" ctrlrange="-200 200"/>
  </actuator>

  <!-- Sensori -->
  <sensor>
    <jointpos name="posizione_porta_sx" joint="slide_sx"/>
    <jointvel name="velocita_porta_sx" joint="slide_sx"/>
    <jointpos name="estensione_cilindro_sx" joint="corsa_cilindro_sx"/>
    <jointvel name="velocita_stelo_sx" joint="corsa_cilindro_sx"/>
    <framepos name="posizione_aggrappo_staffa_sx" objtype="site" objname="aggrappo_staffa_maniglia_sx"/>
    <framepos name="posizione_maniglia_sx" objtype="site" objname="target_manigliasx"/>

    <jointpos name="posizione_porta_dx" joint="slide_dx"/>
    <jointvel name="velocita_porta_dx" joint="slide_dx"/>
    <jointpos name="estensione_cilindro_dx" joint="corsa_cilindro_dx"/>
    <jointvel name="velocita_stelo_dx" joint="corsa_cilindro_dx"/>
    <framepos name="posizione_aggrappo_staffa_dx" objtype="site" objname="aggrappo_staffa_maniglia_dx"/>
    <framepos name="posizione_maniglia_dx" objtype="site" objname="target_manigliadx"/>
  </sensor>

</mujoco>