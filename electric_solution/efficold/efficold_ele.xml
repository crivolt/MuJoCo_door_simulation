<mujoco model="Test_efficold_mechanical_rotary_system">

  <compiler angle="radian"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <asset>
    <mesh name="frigo_mesh" file="efficold_corpo.obj"/>
    <mesh name="porta_mesh" file="efficold_porta.obj"/>
  </asset>

  <worldbody>
    <geom name="pavimento" type="plane" size="5 5 0.1" rgba="0.8 0.9 0.8 1"/>
    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" pos="0 0 5" dir="0 0 -1" castshadow="false"/>

    <body name="sistema_meccanico_dedicato" pos="-0.2 1.343876 0">

      <geom name="base_meccanica" type="box" pos="0 0 0.03" size="0.35 0.25 0.03" rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0"/>
      <geom name="colonna_fissa" type="cylinder" pos="0 0 0.375" size="0.05 0.42" rgba="0.25 0.25 0.25 1" contype="0" conaffinity="0"/>

      <body name="colonna_regolabile" pos="0 0 1.0">
        <inertial pos="0 0 -0.20" mass="4.0" diaginertia="0.08 0.08 0.02"/>
        <geom name="colonna_mobile" type="cylinder" pos="0 0 -0.20" size="0.04 0.30" rgba="0.45 0.45 0.45 1" contype="0" conaffinity="0"/>

        <body name="motoriduttore" pos="0 0 0">
          <inertial pos="0 0 0" mass="3.0" diaginertia="0.04 0.04 0.03"/>
          <geom name="motoriduttore_visual" type="cylinder" pos="0 0 0" size="0.09 0.06" rgba="0.05 0.05 0.05 1" contype="0" conaffinity="0"/>
          <site name="asse_motoriduttore" pos="0 0 0" size="0.035" rgba="0 0 1 1"/>

          <body name="braccio_rotante" pos="0 0 0" xyaxes="0 -0.983832 -0.179094 0 0.179094 -0.983832">
            <joint name="giunto_rotante" type="hinge" axis="0 0 1" range="-1.5708 1.5708" limited="true" damping="5" frictionloss="1"/>

            <inertial pos="0.465 0 0" mass="2.5" diaginertia="0.08 0.08 0.006"/>
            <geom name="braccio_guida_visual" type="capsule" fromto="0 0 0 0.94 0 0" size="0.025" rgba="0.9 0.55 0.1 1" contype="0" conaffinity="0"/>
            <site name="asse_braccio" pos="0.94 0 0" size="0.025" rgba="1 0.5 0 1"/>

            <body name="carrello_telescopico" pos="0.949223 0 0">
              <joint name="compensazione_radiale" type="slide" axis="1 0 0" range="-0.45 0.10" limited="true" damping="15" frictionloss="0.5"/>

              <inertial pos="0 0 0" mass="0.8" diaginertia="0.004 0.004 0.002"/>
              <geom name="carrello_visual" type="box" pos="0 0 0" size="0.055 0.04 0.025" rgba="0.2 0.6 1 1" contype="0" conaffinity="0"/>
              <geom name="stelo_telescopico_visual" type="capsule" fromto="-0.40 0 0 0 0 0" size="0.018" rgba="0.75 0.75 0.75 1" contype="0" conaffinity="0"/>

              <body name="giunto_allineamento" pos="0 0 0">
                <joint name="snodo_allineamento" type="ball" damping="0.1"/>

                <inertial pos="0 0 0" mass="0.4" diaginertia="0.002 0.002 0.002"/>
                <geom name="snodo_allineamento_visual" type="sphere" pos="0 0 0" size="0.035" rgba="0.1 0.6 1 1" contype="0" conaffinity="0"/>

                <body name="end_effector" pos="0 0 0">
                  <inertial pos="0 0 0" mass="0.3" diaginertia="0.001 0.001 0.001"/>
                  <geom name="end_effector_visual" type="sphere" pos="0 0 0" size="0.045" rgba="0.8 0.1 0.1 1" contype="0" conaffinity="0"/>
                  <site name="punto_presa_meccanico" pos="0 0 0" size="0.03" rgba="1 0 0 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Banco frigo Efficold: dati invariati -->
    <body name="banco_frigo" pos="-0.5 0.4 0">
      <geom type="mesh" mesh="frigo_mesh" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>

      <body name="porta" pos="0 0 0">
        <joint name="giunto_porta" type="hinge" pos="-0.2 0.475 0.8" axis="1 0 0" range="-2.0944 0" limited="true" damping="2.0" frictionloss="1.86" stiffness="0" springref="0"/>
        <inertial pos="0.15 0.475 0.525" mass="9" diaginertia="0.23 0.23 0.23"/>
        <geom type="mesh" mesh="porta_mesh" rgba="0.6 0.6 0.6 0.8" contype="0" conaffinity="0"/>

        <body name="maniglia_body" pos="0.3 0.01 0.83" euler="0 1.57 0">
          <geom name="maniglia" type="cylinder" size="0.015 0.15" rgba="0.8 0.2 0.2 1" contype="0" conaffinity="0"/>
          <site name="target_maniglia" pos="0 0 0" size="0.025" rgba="1 0 0 0.5"/>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <connect name="presa_meccanica_maniglia"
             site1="punto_presa_meccanico"
             site2="target_maniglia"
             solimp="0.85 0.95 0.002"
             solref="0.03 1"/>
  </equality>

  <actuator>
    <motor name="motore_motoriduttore"
           joint="giunto_rotante"
           gear="1"
           ctrllimited="true"
           ctrlrange="-150 150"/>
  </actuator>

  <sensor>
    <jointpos name="angolo_porta" joint="giunto_porta"/>
    <jointvel name="velocita_porta" joint="giunto_porta"/>

    <jointpos name="angolo_braccio" joint="giunto_rotante"/>
    <jointvel name="velocita_braccio" joint="giunto_rotante"/>

    <jointpos name="compensazione_radiale_pos" joint="compensazione_radiale"/>
    <jointvel name="compensazione_radiale_vel" joint="compensazione_radiale"/>

    <framepos name="posizione_punto_presa_meccanico" objtype="site" objname="punto_presa_meccanico"/>
    <framepos name="posizione_maniglia" objtype="site" objname="target_maniglia"/>
  </sensor>

</mujoco>