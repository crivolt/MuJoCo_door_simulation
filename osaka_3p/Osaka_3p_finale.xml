<mujoco model="Test_osaka_3p_con_panda">

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <include file="franka_emika_panda/panda.xml"/>

    <asset>
        <mesh name="frigo_mesh" file="Osaka_3p_corpo.obj"/>
        <mesh name="porta_sx_mesh" file="Osaka_3p_portasx.obj"/>
        <mesh name="porta_dx_mesh" file="Osaka_3p_portadx.obj"/>
    </asset>

    <worldbody>
        <geom name="pavimento" type="plane" size="5 5 0.1" rgba="0.8 0.9 0.8 1"/>
        <light directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" pos="0 0 5" dir="0 0 -1" castshadow="false"/>
        <geom name="piedistallo_robot" type="box" pos="0 0 0.15" size="0.15 0.15 0.15" rgba="0.4 0.4 0.4 1" contype="0" conaffinity="0"/>

        <body name="banco_frigo" pos="-0.7 0.6 0">
            
            <geom type="mesh" mesh="frigo_mesh" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>
            
            <body name="porta_sx" pos="0 0 0">
                <joint name="giunto_porta_sx" type="hinge" pos="0.04 0 0" axis="0 0 1" range="-1.658 0" limited="true" damping="0.05"/>
                <inertial pos="0.18 0 0.6" mass="1.5" diaginertia="0.054 0.054 0.0108"/>
                <geom type="mesh" mesh="porta_sx_mesh" rgba="0.3 0.8 0.9 0.4" contype="1" conaffinity="1"/> 
                <site name="debug_cernierasx" pos="0.04 0 0" size="0.03" rgba="0 1 0 1"/>
                
                <body name="maniglia_sx" pos="0.60 -0.05 1.0">
                    <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
                    <geom name="manigliasx" type="cylinder" size="0.015 0.15" rgba="0.8 0.2 0.2 1" contype="0" conaffinity="0"/>
                    <site name="target_manigliasx" pos="0 0 0" size="0.02" rgba="1 0 0 0.5"/>
                </body>
            </body>

            <body name="porta_dx" pos="0 0 0">
                <joint name="giunto_porta_dx" type="hinge" pos="1.305 0 0" axis="0 0 1" range="0 1.658" limited="true"  damping="0.05"/>
                <inertial pos="0.18 0 0.6" mass="1.5" diaginertia="0.054 0.054 0.0108"/>
                <geom type="mesh" mesh="porta_dx_mesh" rgba="0.3 0.8 0.9 0.4" contype="0" conaffinity="0"/>
                <site name="debug_cernieradx" pos="1.305 0 0" size="0.03" rgba="0 1 0 1"/>

                <body name="maniglia_dx" pos="0.74 -0.05 1.0">
                    <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
                    <geom name="manigliadx" type="cylinder" size="0.015 0.15" rgba="0.8 0.2 0.2 1" contype="0" conaffinity="0"/>
                    <site name="target_manigliadx" pos="0 0 0" size="0.02" rgba="1 0 0 0.5"/>
                </body>
            </body>

        </body>
    </worldbody>

    <equality>
        <weld name="presa_sx" site1="grasp_site" site2="target_manigliasx" active="false" solimp="0.8 0.9 0.01" solref="0.04 1"/>
        <weld name="presa_dx" site1="grasp_site" site2="target_manigliadx" active="false" solimp="0.8 0.9 0.01" solref="0.04 1"/>
    </equality>
</mujoco>

